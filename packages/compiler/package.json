{
  "name": "@flint/compiler",
  "version": "2.0.0",
  "description": "Flint compiler — JSX with tree-shaking and optimizations",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "acorn-jsx": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.3"
  },
  "files": ["dist"],
  "license": "MIT",
  "keywords": ["compiler", "jsx", "tree-shaking", "flint"]
}
