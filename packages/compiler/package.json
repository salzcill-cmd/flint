{
  "name": "@flint/compiler",
  "version": "3.2.0",
  "description": "Flint compiler — JSX with tree-shaking and optimizations",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acorn": "^8.14.1",
    "acorn-jsx": "^5.3.2",
    "esbuild": "^0.28.2"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.3"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/salzcill-cmd/flint.git",
    "directory": "packages/compiler"
  },
  "bugs": {
    "url": "https://github.com/salzcill-cmd/flint/issues"
  },
  "homepage": "https://github.com/salzcill-cmd/flint#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "compiler",
    "jsx",
    "tree-shaking",
    "flint"
  ]
}
