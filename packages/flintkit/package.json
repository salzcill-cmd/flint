{
  "name": "flintkit",
  "version": "3.2.0",
  "description": "FlintKit — Metaframework for Flint with file-based routing, SSR, and full-stack features",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "metaframework",
    "ssr",
    "file-based-routing",
    "reactivity"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/salzcill-cmd/flint.git",
    "directory": "packages/flintkit"
  },
  "bugs": {
    "url": "https://github.com/salzcill-cmd/flint/issues"
  },
  "homepage": "https://github.com/salzcill-cmd/flint#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flint/compiler": "workspace:*",
    "@flint/reactivity": "workspace:*",
    "@flint/runtime": "workspace:*",
    "@flint/vite-plugin": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
