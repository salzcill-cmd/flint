{
  "name": "@flint/runtime",
  "version": "2.0.0",
  "description": "Flint runtime — animations, transitions, and advanced DevTools",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flint/reactivity": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.3"
  },
  "files": ["dist"],
  "license": "MIT",
  "keywords": ["runtime", "animations", "transitions", "devtools", "flint"]
}
