{
  "name": "@flint/runtime",
  "version": "3.0.0",
  "description": "Flint runtime — complete framework with i18n, PWA, query, SEO, a11y, hooks",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./a11y": {
      "types": "./dist/a11y/index.d.ts",
      "import": "./dist/a11y/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flint/reactivity": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "typescript": "^5.7.3"
  },
  "files": ["dist"],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["runtime", "i18n", "pwa", "query", "seo", "a11y", "hooks", "flint"]
}
