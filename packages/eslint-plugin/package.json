{
  "name": "@flint/eslint-plugin",
  "version": "3.2.0",
  "description": "ESLint plugin for Flint — linting rules for signals, components, and best practices",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "eslint",
    "lint",
    "signals"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/salzcill-cmd/flint.git",
    "directory": "packages/eslint-plugin"
  },
  "bugs": {
    "url": "https://github.com/salzcill-cmd/flint/issues"
  },
  "homepage": "https://github.com/salzcill-cmd/flint#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/utils": "^8.0.0"
  }
}
