{
  "name": "@flint/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint plugin for Flint — linting rules for signals, components, and best practices",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "flint",
    "eslint",
    "lint",
    "signals"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=8.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "eslint": "^8.57.0",
    "@typescript-eslint/utils": "^8.0.0"
  }
}
