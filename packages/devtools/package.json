{
  "name": "@flint/devtools",
  "version": "3.2.0",
  "description": "Flint DevTools — Browser extension and dev server integration for debugging Flint applications",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./client": {
      "import": "./dist/client.js",
      "types": "./dist/client.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "flint",
    "devtools",
    "debug",
    "browser-extension"
  ],
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/salzcill-cmd/flint.git",
    "directory": "packages/devtools"
  },
  "bugs": {
    "url": "https://github.com/salzcill-cmd/flint/issues"
  },
  "homepage": "https://github.com/salzcill-cmd/flint#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@flint/reactivity": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.3"
  }
}
