  "bugs": {
    "url": "https://github.com/salzcill-cmd/flint/issues"
  },
  "homepage": "https://github.com/salzcill-cmd/flint#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "@playwright/test": "^1.40.0"
  }
