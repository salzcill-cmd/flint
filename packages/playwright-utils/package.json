{
  "name": "@flint/playwright-utils",
  "version": "3.2.0",
  "description": "Playwright utilities for Flint E2E testing",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
