{
  "name": "@flint/cli",
  "version": "0.0.1",
  "description": "Flint CLI — create, dev, build, and test Flint projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "flint": "dist/index.js"
  },
