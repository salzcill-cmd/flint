{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "jsx": "react-jsx",
    "jsxImportSource": "flint",
    "paths": {
      "flint": ["./node_modules/flint"],
      "flint/*": ["./node_modules/flint/*"]
    }
  }
}
